    <style name="SearchMenu" parent="android:Theme.DeviceDefault.Dialog.Alert">
        <item name="android:windowBackground">@drawable/menu_panel</item>
        <item name="android:colorBackground">#111F32</item>
        <item name="android:colorAccent">#B8D7FF</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#B8C8DB</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:backgroundDimAmount">0.65</item>
        <item name="android:windowMinWidthMajor">65%</item>
        <item name="android:windowMinWidthMinor">80%</item>
